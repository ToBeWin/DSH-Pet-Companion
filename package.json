{
  "name": "@tobewin/dsh-pet-companion",
  "version": "0.1.0",
  "description": "Animated, local-only desktop pets for DeepSeek Harness",
  "license": "MIT",
  "author": "ToBeWin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ToBeWin/DSH-Pet-Companion.git"
  },
  "bugs": {
    "url": "https://github.com/ToBeWin/DSH-Pet-Companion/issues"
  },
  "homepage": "https://github.com/ToBeWin/DSH-Pet-Companion#readme",
  "keywords": ["deepseek-harness", "dsh", "pet", "companion", "desktop"],
  "publishConfig": { "access": "public" },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./client": { "default": "./lib/client.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "CHANGELOG.md", "LICENSE"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "scripts": {
    "build": "rm -rf lib && tsc -p tsconfig.json && cp client/client.js lib/client.js",
    "check": "tsc --noEmit",
    "qa:capture": "../dsh-desktop/node_modules/.bin/electron script/capture-pet-companion.cjs",
    "prepack": "pnpm build"
  },
  "devDependencies": { "typescript": "^5.8.0" }
}
